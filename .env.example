# OPTIONAL public overrides. The existing PUBLIC URL and publishable key remain
# in lib/public-config.ts. Access is still controlled by verified membership/RLS.
# Set BOTH when targeting a different authorized project; partial values fail closed.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Never expose secret/service_role keys. For fictional demo open /demo/ instead.

# Local-only development: npm run dev binds loopback. Never enable on a shared host.
# HQ_LOCAL_DEVELOPMENT=true
# Shared/private development preview gate (server-only, enter securely):
# HQ_PREVIEW_USERNAME=
# HQ_PREVIEW_PASSWORD=

# Drive is disabled by default. See docs/drive-integration.md before configuring.
HQ_DRIVE_ENABLED=false
# HQ_GOOGLE_CLIENT_ID=
# HQ_GOOGLE_CLIENT_SECRET=
# HQ_GOOGLE_REFRESH_TOKEN=
# HQ_UPLOAD_ENCRYPTION_KEY=
# HQ_SUPABASE_SERVICE_ROLE_KEY=
# Never put these server values in NEXT_PUBLIC variables or commit real values.
